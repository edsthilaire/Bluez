-- Función para volar sobre NPCs
function EnableFlight()
    if not Settings.FlyAboveNPCs then return end
    
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        -- Activar vuelo
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 25, 0)
        bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
        bodyVelocity.Parent = character.HumanoidRootPart
        
        -- Mantener altura fija
        coroutine.wrap(function()
            while Settings.FlyAboveNPCs and Settings.AutoFarm do
                if character and character.HumanoidRootPart then
                    character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                end
                wait(0.1)
            end
            if bodyVelocity then bodyVelocity:Destroy() end
        end)()
    end
end

-- Función para obtener nivel del jugador
function GetPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 0
end

-- Función para encontrar NPC más cercano
function FindNearestNPC()
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc:FindFirstChild("HumanoidRootPart") then
            local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance and distance < Settings.AttackRange then
                closestDistance = distance
                closestNPC = npc
            end
        end
    end
    
    return closestNPC, closestDistance
end

-- Función para atacar desde lejos
function AttackFromDistance(npc)
    if not npc then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Posicionarse a distancia segura
    local npcPos = npc.HumanoidRootPart.Position
    local attackPos = npcPos + Vector3.new(0, Settings.FarmDistance, 0)
    
    -- Teletransportarse a posición de ataque
    character.HumanoidRootPart.CFrame = CFrame.new(attackPos)
    
    -- Realizar ataques
    VirtualInput:SendKeyEvent(true, "E", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "E", false, game)
    
    VirtualInput:SendKeyEvent(true, "F", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "F", false, game)
    
    VirtualInput:SendKeyEvent(true, "R", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "R", false, game)
    
    VirtualInput:SendKeyEvent(true, "T", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "T", false, game)
end

-- Función para aceptar misiones automáticamente
function AcceptQuests()
    if not Settings.AutoQuest then return end
    
    -- Buscar NPCs de quest
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Head") and npc.Head:FindFirstChild("Dialog") then
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - npc.HumanoidRootPart.Position).Magnitude
            if distance < 20 then
                -- Interactuar con NPC para aceptar quest
                fireproximityprompt(npc.Head.Dialog)
                wait(1)
            end
        end
    end
end

-- Función para verificar si puede ir a nueva isla
function CheckNewIsland()
    local currentLevel = GetPlayerLevel()
    
    for _, island in pairs(Islands) do
        if currentLevel >= island.Level and currentLevel < island.Level + 50 then
            return island
        end
    end
    return nil
end

-- Función para teletransportarse a nueva isla
function GoToNewIsland(island)
    if not island then return end
    
    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(island.Position)
    print("✅ Teletransportado a: " .. island.Name)
    wait(3)
end

-- Función principal de farm
function StartAutoFarm()
    getgenv().Settings.AutoFarm = true
    
    coroutine.wrap(function()
        while getgenv().Settings.AutoFarm do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                pcall(function()
                    -- Activar vuelo
                    if Settings.FlyAboveNPCs then
                        EnableFlight()
                    end
                    
                    -- Buscar NPC más cercano
                    local npc, distance = FindNearestNPC()
                    
                    if npc then
                        -- Atacar desde distancia
                        AttackFromDistance(npc)
                    else
                        -- Buscar nueva isla si no hay NPCs
                        if Settings.AutoNewIsland then
                            local newIsland = CheckNewIsland()
                            if newIsland then
                                GoToNewIsland(newIsland)
                            end
                        end
                    end
                    
                    -- Aceptar misiones automáticamente
                    if Settings.AutoQuest then
                        AcceptQuests()
                    end
                    
                end)
            end
            wait(0.5)
        end
    end)()
end

