-- FUNCIONES BÁSICAS MEJORADAS
function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function GetPlayerLevel()
    local data = Player:FindFirstChild("Data")
    if data then
        local level = data:FindFirstChild("Level")
        if level then
            return level.Value
        end
    end
    return 1
end

function FindNearestNPC()
    if not IsAlive(Character) then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    
    -- Buscar en todas las ubicaciones posibles
    local searchFolders = {"Enemies", "NPCs", "Monsters", "BasicMob"}
    
    for _, folderName in pairs(searchFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and IsAlive(npc) then
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local distance = (Root.Position - hrp.Position).Magnitude
                        if distance < closestDistance and distance < 500 then
                            closestDistance = distance
                            closestNPC = npc
                        end
                    end
                end
            end
        end
    end
    
    -- Buscar bosses
    for _, npc in pairs(Workspace:GetChildren()) do
        if npc:IsA("Model") and IsAlive(npc) and npc:GetAttribute("IsBoss") then
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local distance = (Root.Position - hrp.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestNPC = npc
                end
            end
        end
    end
    
    return closestNPC
end

function TeleportTo(position)
    if not IsAlive(Character) then return false end
    if typeof(position) == "Instance" then
        position = position.Position
    end
    Root.CFrame = CFrame.new(position + Vector3.new(0, Settings.FarmDistance, 0))
    return true
end

function TeleportToNPC(npc)
    if not npc or not IsAlive(npc) then return false end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return TeleportTo(hrp.Position)
end

-- SISTEMA DE ATAQUE MEJORADO
function PerformAttack()
    if not IsAlive(Character) then return end
    
    -- Teclas de ataque para diferentes herramientas
    local attackKeys = {"E", "F", "R", "T", "Y", "G", "H"}
    local tool = Character:FindFirstChildOfClass("Tool")
    
    if tool then
        -- Ataque básico (click)
        if Settings.AutoClick then
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.05)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
        
        -- Habilidades
        for _, key in pairs(attackKeys) do
            VirtualInput:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInput:SendKeyEvent(false, key, false, game)
            task.wait(0.1)
        end
    end
end

-- SISTEMA DE HABILIDADES AUTOMÁTICAS
function AutoHaki()
    if not Settings.AutoBuso then return end
    VirtualInput:SendKeyEvent(true, "Q", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Q", false, game)
end

function AutoKen()
    if not Settings.AutoKen then return end
    VirtualInput:SendKeyEvent(true, "Z", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Z", false, game)
end

-- SISTEMA DE RECOLECCIÓN
function FindChests()
    local chests = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find("chest") and obj:IsA("Model") then
            table.insert(chests, obj)
        end
    end
    return chests
end

function FindFruits()
    local fruits = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name:find("Fruit") and obj:IsA("Model") then
            table.insert(fruits, obj)
        end
    end
    return fruits
end

function CollectChests()
    if not Settings.AutoCollectChests then return end
    local chests = FindChests()
    for _, chest in pairs(chests) do
        local hrp = chest:FindFirstChild("HumanoidRootPart")
        if hrp and (Root.Position - hrp.Position).Magnitude < 100 then
            TeleportTo(hrp.Position)
            task.wait(0.5)
            fireproximityprompt(chest:FindFirstChildOfClass("ProximityPrompt"))
        end
    end
end

function CollectFruits()
    if not Settings.AutoCollectFruits then return end
    local fruits = FindFruits()
    for _, fruit in pairs(fruits) do
        local hrp = fruit:FindFirstChild("HumanoidRootPart")
        if hrp and (Root.Position - hrp.Position).Magnitude < 100 then
            TeleportTo(hrp.Position)
            task.wait(0.5)
            firetouchinterest(Root, hrp, 0)
            firetouchinterest(Root, hrp, 1)
        end
    end
end

-- SISTEMA DE MEJORAS DE PLAYER
function ApplyPlayerStats()
    if not IsAlive(Character) then return end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = Settings.WalkSpeed
        humanoid.JumpPower = Settings.JumpPower
    end
end

function ToggleNoclip()
    if Settings.Noclip then
        if NoclipConnection then NoclipConnection:Disconnect() end
        NoclipConnection = RunService.Stepped:Connect(function()
            if IsAlive(Character) then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- SISTEMA DE VISUALES
function ToggleFullBright()
    if Settings.FullBright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
    end
end

function ToggleHidePlayers()
    if Settings.HidePlayers then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= Player then
                local char = player.Character
                if char then
                    char:Destroy()
                end
            end
        end
    end
end

function OptimizeGraphics()
    if Settings.LowGFX then
        -- Reducir calidad gráfica
        settings().Rendering.QualityLevel = 1
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Part") then
                obj.Material = Enum.Material.Plastic
            end
        end
    end
end

-- SISTEMA DE FARM AUTOMÁTICO MEJORADO
function StartAutoFarm()
    Settings.AutoFarm = true
    
    while Settings.AutoFarm and task.wait(Settings.SmoothMode and 0.1 or 0.3) do
        if not IsAlive(Character) then
            task.wait(2)
            Character = Player.Character or Player.CharacterAdded:Wait()
            Root = Character:WaitForChild("HumanoidRootPart")
            continue
        end
        
        -- Aplicar mejoras de player
        ApplyPlayerStats()
        
        -- Usar habilidades automáticas
        AutoHaki()
        AutoKen()
        
        -- Buscar NPC más cercano
        local npc = FindNearestNPC()
        
        if npc then
            TargetNPC = npc
            -- Teletransportarse al NPC
            if TeleportToNPC(npc) then
                -- Atacar
                PerformAttack()
                
                -- Mostrar información
                local humanoid = npc:FindFirstChildOfClass("Humanoid")
                local health = humanoid and math.floor(humanoid.Health) or "N/A"
                print("🎯 BLACKZ - Farmeando: " .. npc.Name .. " | Vida: " .. health)
            end
        else
            print("🔍 BLACKZ - Buscando NPCs...")
            TargetNPC = nil
            
            -- Recolectar items si no hay NPCs
            CollectChests()
            CollectFruits()
        end
    end
end

