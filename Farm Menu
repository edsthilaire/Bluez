-- FUNCIÓN PARA BUSCAR NPCs
function FindNearestNPC()
    if not LocalPlayer.Character then return nil end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    -- Buscar en Workspace.NPCs
    if Workspace:FindFirstChild("NPCs") then
        for _, npc in pairs(Workspace.NPCs:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                if npc:FindFirstChild("HumanoidRootPart") then
                    local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestNPC = npc
                    end
                end
            end
        end
    end
    
    -- Si no encuentra en NPCs, buscar en Workspace directamente
    if not closestNPC then
        for _, npc in pairs(Workspace:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                if npc:FindFirstChild("HumanoidRootPart") then
                    local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                    if distance < closestDistance and distance < 100 then
                        closestDistance = distance
                        closestNPC = npc
                    end
                end
            end
        end
    end
    
    return closestNPC
end

-- FUNCIÓN PARA ATACAR
function AttackNPC()
    -- Presionar teclas de ataque
    local attackKeys = {"E", "F", "R", "T"}
    
    for _, key in pairs(attackKeys) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.1)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.1)
    end
end

-- FUNCIÓN PARA TELEPORT
function TeleportToNPC(npc)
    if not npc then return false end
    if not npc:FindFirstChild("HumanoidRootPart") then return false end
    if not LocalPlayer.Character then return false end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    local npcPos = npc.HumanoidRootPart.Position
    local teleportPos = npcPos + Vector3.new(0, getgenv().Blackz.FarmDistance, 0)
    
    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
    return true
end

-- FUNCIÓN PRINCIPAL DE FARM
function StartAutoFarm()
    getgenv().Blackz.AutoFarm = true
    
    local farmConnection
    farmConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().Blackz.AutoFarm then
            farmConnection:Disconnect()
            return
        end
        
        -- Verificar que el personaje esté vivo
        if not LocalPlayer.Character then return end
        if not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
        if LocalPlayer.Character.Humanoid.Health <= 0 then return end
        
        -- Buscar NPC más cercano
        local nearestNPC = FindNearestNPC()
        
        if nearestNPC then
            -- Teletransportarse al NPC
            local success = TeleportToNPC(nearestNPC)
            
            if success then
                -- Atacar al NPC
                AttackNPC()
                
                -- Mostrar en consola
                print("🎯 BLACKZ - Atacando: " .. nearestNPC.Name)
            end
        else
            print("🔍 BLACKZ - Buscando NPCs...")
        end
    end)
end

