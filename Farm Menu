-- SEA-1 AUTO-FARM COMPLETO (Anti Agua + Anti Atascos Mejorado!)
--------------------------------------------------

local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local WS = game:GetService("Workspace")

local Plr = Players.LocalPlayer
local Root = Plr.Character:WaitForChild("HumanoidRootPart")

local Config = {
    AutoFarm = false,
    FarmDistance = 16,
    AttackDelay = 0.12,
    StuckCheckDelay = 1,
    StuckThreshold = 2,
}

--------------------------------------------------
-- FUNCIONES DE FARMEO & ANTI-AGUA...
--------------------------------------------------

-- --- Anti-Atascos Mejorado!
local lastPos = Root.Position
local lastUnstuck = tick()
local stuckCount = 0

task.spawn(function()
    while task.wait(Config.StuckCheckDelay) do
        if not Config.AutoFarm then continue end

        local movedDist = (Root.Position - lastPos).Magnitude

        if movedDist < Config.StuckThreshold then -- Si no se movió mucho...
            stuckCount += 1

            -- Eleva + empuja para liberarse (más agresivo):
            local elevate = math.random(8 + stuckCount*4, math.min(stuckCount*12+20,40))
            local push = Vector3.new(
                math.random(-6,6),
                elevate,
                math.random(-6,-14)
            )
            Root.CFrame = Root.CFrame + push

            -- Si lleva demasiado tiempo atascado...
            if stuckCount > 6 then -- Reseteamos la posición por seguridad.
                Root.CFrame = CFrame.new(Root.Position + Vector3.new(math.random(-30,30),100,-math.random(-40,-80)))
                stuckCount = 0 -- reset count.
            end

        else -- Si se movió bien...
            stuckCount = math.max(stuckCount-1,0)
        end

        lastPos = Root.Position

        if stuckCount > 10 then -- Si sigue atascado tras muchos intentos...
            Root.CFrame = CFrame.new(Root.Position + Vector3.new(math.random(-30,30),120,-math.random(-60,-120)))
            stuckCount = 0 -- reset count.
        end

        lastUnstuck = tick()
    end
end)

