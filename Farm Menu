-- FUNCIÓN BUSCAR NPC MÁS CERCANO
function FindNearestNPC()
    local closestNPC = nil
    local closestDistance = math.huge
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
            if npc:FindFirstChild("HumanoidRootPart") then
                local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestNPC = npc
                end
            end
        end
    end
    
    return closestNPC
end

-- FUNCIÓN ATAQUE REAL
function AttackNPC()
    -- Simular tecla E (ataque principal)
    VirtualInput:SendKeyEvent(true, "E", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "E", false, game)
    
    -- Simular tecla F (ataque secundario)
    VirtualInput:SendKeyEvent(true, "F", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "F", false, game)
    
    -- Simular tecla R (habilidad)
    VirtualInput:SendKeyEvent(true, "R", false, game)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "R", false, game)
end

-- FUNCIÓN TELEPORT A NPC
function TeleportToNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local npcPos = npc.HumanoidRootPart.Position
    local teleportPos = npcPos + Vector3.new(0, getgenv().Blackz.FarmDistance, 0)
    
    char.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
end

-- FUNCIÓN PRINCIPAL DE FARM
function StartRealFarm()
    getgenv().Blackz.AutoFarm = true
    
    spawn(function()
        while getgenv().Blackz.AutoFarm do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                -- Buscar NPC más cercano
                local nearestNPC = FindNearestNPC()
                
                if nearestNPC then
                    -- Teletransportarse al NPC
                    TeleportToNPC(nearestNPC)
                    wait(0.5)
                    
                    -- Atacar al NPC
                    AttackNPC()
                    
                    print("🎯 Atacando NPC: " .. nearestNPC.Name)
                else
                    print("🔍 Buscando NPCs...")
                end
            else
                print("💀 Personaje muerto, esperando respawn...")
            end
            
            wait(1) -- Esperar 1 segundo entre ciclos
        end
    end)
end

