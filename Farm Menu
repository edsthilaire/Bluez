-- 🔄 Buscar NPCs automáticamente
-- 🎯 Teletransportarse a ellos
-- ⚔️ Atacar con E, F, R, T
-- NO Silver | NO Redz-Hub | Solo El Fam

local Players       = game:GetService("Players")
local VirtualInput  = game:GetService("VirtualInputManager")
local Workspace     = game:GetService("Workspace")
local RunService    = game:GetService("RunService")

local LPlayer = Players.LocalPlayer
local HumanoidRootPart = LPlayer.Character and LPlayer.Character:WaitForChild("HumanoidRootPart")

--------------------------------------------------
-- CONFIG
--------------------------------------------------
local Config = {
    AutoFarm     = false,
    FarmDistance = 15,   -- altura sobre el NPC
    AttackDelay  = 0.12
}

--------------------------------------------------
-- 1) 🔄 BUSCAR NPCs AUTOMÁTICAMENTE
--------------------------------------------------
function FindNearestEnemy()
    if not (LPlayer.Character and HumanoidRootPart) then return nil end
    local closest, dist = nil, math.huge
    local myPos = HumanoidRootPart.Position

    -- Cambia "Enemies" por la carpeta que use tu juego
    for _, npc in ipairs(Workspace:GetDescendants()) do
        if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0
           and npc:FindFirstChild("HumanoidRootPart") then
            local d = (myPos - npc.HumanoidRootPart.Position).Magnitude
            if d < dist then
                closest, dist = npc, d
            end
        end
    end
    return closest
end

--------------------------------------------------
-- 2) 🎯 TELETRANSPORTARSE AL NPC
--------------------------------------------------
function TeleportToNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return false end
    local np = npc.HumanoidRootPart.Position
    HumanoidRootPart.CFrame = CFrame.new(np + Vector3.new(math.random(-2,2), Config.FarmDistance, math.random(-2,2)))
    return true
end

--------------------------------------------------
-- 3) ⚔️ ATACAR CON E, F, R, T
--------------------------------------------------
function Attack()
    local keys = {"E","F","R","T"}
    for _, k in ipairs(keys) do
        if not Config.AutoFarm then break end
        VirtualInput:SendKeyEvent(true,  k, false, game)
        task.wait(Config.AttackDelay)
        VirtualInput:SendKeyEvent(false, k, false, game)
        task.wait(Config.AttackDelay)
    end
end

--------------------------------------------------
-- LOOP AUTO-FARM
--------------------------------------------------
function StartAutoFarm()
    Config.AutoFarm = true
    task.spawn(function()
        while Config.AutoFarm do
            local npc = FindNearestEnemy()  -- 🔄
            if npc then
                if TeleportToNPC(npc) then  -- 🎯
                    task.wait(0.2)
                    Attack()                -- ⚔️
                end
            else
                task.wait(0.5)
            end
            task.wait(0.5)
        end
    end)
end

