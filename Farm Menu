-- ⚡ BLACKZ HUB - AUTO FARM SIMPLIFICADO
-- Basado en redz Hub pero más simple y funcional

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualInput = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Root = Character:WaitForChild("HumanoidRootPart")

-- CONFIGURACIÓN SIMPLE
local Settings = {
    AutoFarm = true,
    FarmDistance = 25,
    BringDistance = 50,
    SelectedTool = "Combat",
    SmoothMode = false
}

-- FUNCIONES BÁSICAS
function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function FindNearestNPC()
    if not IsAlive(Character) then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    
    -- Buscar en carpetas de enemigos
    local enemyFolders = {"Enemies", "NPCs", "Monsters"}
    
    for _, folderName in pairs(enemyFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and IsAlive(npc) then
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local distance = (Root.Position - hrp.Position).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestNPC = npc
                        end
                    end
                end
            end
        end
    end
    
    -- Si no encuentra en carpetas, buscar en todo Workspace
    if not closestNPC then
        for _, npc in pairs(Workspace:GetChildren()) do
            if npc:IsA("Model") and IsAlive(npc) then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp and not Players:GetPlayerFromCharacter(npc) then
                    local distance = (Root.Position - hrp.Position).Magnitude
                    if distance < closestDistance and distance < 500 then
                        closestDistance = distance
                        closestNPC = npc
                    end
                end
            end
        end
    end
    
    return closestNPC
end

function TeleportToNPC(npc)
    if not npc or not IsAlive(npc) then return false end
    if not IsAlive(Character) then return false end
    
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Teletransportarse encima del NPC
    Root.CFrame = hrp.CFrame + Vector3.new(0, Settings.FarmDistance, 0)
    return true
end

function AttackNPC()
    -- Usar todas las teclas de ataque posibles
    local attackKeys = {"E", "F", "R", "T", "Y", "G", "H"}
    
    for _, key in pairs(attackKeys) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.1)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.1)
    end
end

-- SISTEMA DE FARM AUTOMÁTICO
function StartAutoFarm()
    Settings.AutoFarm = true
    
    while Settings.AutoFarm do
        if not IsAlive(Character) then
            task.wait(2)
            Character = Player.Character or Player.CharacterAdded:Wait()
            Root = Character:WaitForChild("HumanoidRootPart")
            continue
        end
        
        local npc = FindNearestNPC()
        
        if npc then
            -- Teletransportarse al NPC
            if TeleportToNPC(npc) then
                -- Atacar
                AttackNPC()
                
                -- Mostrar información
                print("🎯 BLACKZ - Farmeando: " .. npc.Name .. " | Vida: " .. math.floor(npc.Humanoid.Health))
            end
        else
            print("🔍 BLACKZ - Buscando NPCs...")
        end
        
        task.wait(Settings.SmoothMode and 0.25 or 0.5)
    end
end

-- INTERFAZ SIMPLE
local success, Library = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
end)

if success then
    local Window = Library.CreateLib("⚡ BLACKZ HUB", "DarkTheme")
    
    local MainTab = Window:NewTab("🏠 Main")
    local MainSection = MainTab:NewSection("Auto Farm")
    
    MainSection:NewToggle("🚀 Auto Farm", "Activar farm automático", function(state)
        Settings.AutoFarm = state
        if state then
            task.spawn(StartAutoFarm)
        end
    end)
    
    MainSection:NewSlider("📏 Distancia", "Distancia de farm", 50, 10, function(value)
        Settings.FarmDistance = value
    end)
    
    MainSection:NewSlider("🎯 Rango", "Rango de búsqueda", 200, 50, function(value)
        Settings.BringDistance = value
    end)
    
    local PlayerTab = Window:NewTab("🎮 Player")
    local PlayerSection = PlayerTab:NewSection("Ajustes")
    
    PlayerSection:NewSlider("🚶 WalkSpeed", "Velocidad", 100, 16, function(value)
        if Character and Character:FindFirstChild("Humanoid") then
            Character.Humanoid.WalkSpeed = value
        end
    end)
    
    PlayerSection:NewKeybind("🔑 Toggle Menu", "Mostrar/ocultar menú", Enum.KeyCode.RightControl, function()
        Library:ToggleUI()
    end)
else
    -- Interfaz de respaldo simple
    local sg = Instance.new("ScreenGui", game.CoreGui)
    local btn = Instance.new("TextButton", sg)
    btn.Size = UDim2.new(0, 200, 0, 50)
    btn.Position = UDim2.new(0, 10, 0, 10)
    btn.Text = "🚀 ACTIVAR AUTO FARM"
    btn.BackgroundColor3 = Color3.new(0, 1, 0)
    btn.TextColor3 = Color3.new(1, 1, 1)
    
    btn.MouseButton1Click:Connect(function()
        Settings.AutoFarm = not Settings.AutoFarm
        if Settings.AutoFarm then
            btn.Text = "⛔ DETENER AUTO FARM"
            btn.BackgroundColor3 = Color3.new(1, 0, 0)
            StartAutoFarm()
        else
            btn.Text = "🚀 ACTIVAR AUTO FARM"
            btn.BackgroundColor3 = Color3.new(0, 1, 0)
        end
    end)
end

-- ANTI-AFK
Player.Idled:Connect(function()
    game:GetService("VirtualUser"):CaptureController()
    game:GetService("VirtualUser"):ClickButton2(Vector2.new())
end)

-- INICIALIZACIÓN
print("⚡ BLACKZ HUB CARGADO!")
print("🎯 Auto Farm simplificado y funcional")
print("🚀 Sistema listo para farmear")

-- Iniciar automáticamente
task.spawn(StartAutoFarm)
