-- FUNCIÓN BUSCAR NPC
function FindNearestNPC()
    if not LocalPlayer.Character then return nil end
    if not LocalPlayer.Character.HumanoidRootPart then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    -- Buscar en NPCs
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
            if npc:FindFirstChild("HumanoidRootPart") then
                local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestNPC = npc
                end
            end
        end
    end
    
    return closestNPC
end

-- FUNCIÓN ATACAR
function AttackNPC()
    local attackKeys = {"E", "F", "R", "T"}
    
    for _, key in pairs(attackKeys) do
        if not getgenv().Blackz.AutoFarm then break end
        VirtualInput:SendKeyEvent(true, key, false, game)
        wait(0.1)
        VirtualInput:SendKeyEvent(false, key, false, game)
        wait(0.1)
    end
end

-- FUNCIÓN TELEPORT
function TeleportToNPC(npc)
    if not npc then return false end
    if not npc.HumanoidRootPart then return false end
    if not LocalPlayer.Character then return false end
    if not LocalPlayer.Character.HumanoidRootPart then return false end
    
    local npcPos = npc.HumanoidRootPart.Position
    local teleportPos = npcPos + Vector3.new(0, getgenv().Blackz.FarmDistance, 0)
    
    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
    return true
end

-- FUNCIÓN PRINCIPAL AUTO FARM
function StartAutoFarm()
    getgenv().Blackz.AutoFarm = true
    
    spawn(function()
        while getgenv().Blackz.AutoFarm do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                pcall(function()
                    -- Buscar NPC
                    local npc = FindNearestNPC()
                    
                    if npc then
                        -- Teletransportarse
                        local success = TeleportToNPC(npc)
                        if success then
                            -- Atacar
                            AttackNPC()
                            print("🎯 BLACKZ - Farmeando: " .. npc.Name)
                        end
                    else
                        print("🔍 BLACKZ - Buscando NPCs...")
                    end
                end)
            end
            wait(0.5)
        end
    end)
end

-- INTERFAZ BLACKZ HUB
local MainTab = Window:NewTab("🏠 MAIN")
