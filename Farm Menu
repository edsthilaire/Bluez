-- MEJORA: Función para volar sobre NPCs
function EnableFlight()
    if not getgenv().Blackz.FlyMode then return end
    if not LocalPlayer.Character then return end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    
    -- Mantener altura fija
    local char = LocalPlayer.Character
    char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
end

--------------------------------------------------
-- 1) 🔄 BUSCAR NPCs MÁS EFICIENTE
--------------------------------------------------
function FindNearestNPC()
    if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then
        return nil
    end
    
    local closestNPC, closestDist = nil, getgenv().Blackz.AttackRange
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position

    -- Buscar en carpetas específicas de Blox Fruits
    local searchFolders = {"Enemies", "NPCs", "Monsters"}
    
    for _, folderName in pairs(searchFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0
                   and npc:FindFirstChild("HumanoidRootPart") then
                    local dist = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestNPC  = npc
                    end
                end
            end
        end
    end
    
    -- Si no encuentra en carpetas, buscar en todo Workspace
    if not closestNPC then
        for _, npc in pairs(Workspace:GetChildren()) do
            if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0
               and npc:FindFirstChild("HumanoidRootPart") then
                local dist = (playerPos - npc.HumanoidRootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestNPC  = npc
                end
            end
        end
    end
    
    return closestNPC
end

--------------------------------------------------
-- 2) 🎯 TELETRANSPORTARSE MEJORADO
--------------------------------------------------
function TeleportToNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return false end
    if not LocalPlayer.Character then return false end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    local root = LocalPlayer.Character.HumanoidRootPart
    local npcPos = npc.HumanoidRootPart.Position
    
    -- Posición de ataque mejorada
    local attackOffset = Vector3.new(
        math.random(-3, 3), 
        getgenv().Blackz.FarmDistance, 
        math.random(-3, 3)
    )
    
    root.CFrame = CFrame.new(npcPos + attackOffset)
    return true
end

--------------------------------------------------
-- 3) ⚔️ ATAQUE MEJORADO
--------------------------------------------------
function AttackNPC()
    local keys = {"E","F","R","T","Y","G","H"} -- Más teclas de ataque
    local comboCount = 3 -- Repetir combo 3 veces
    
    for i = 1, comboCount do
        if not getgenv().Blackz.AutoFarm then break end
        
        for _, key in ipairs(keys) do
            if not getgenv().Blackz.AutoFarm then break end
            VirtualInput:SendKeyEvent(true, key, false, game)
            task.wait(0.08) -- Más rápido
            VirtualInput:SendKeyEvent(false, key, false, game)
            task.wait(0.08)
        end
        task.wait(0.3) -- Pausa entre combos
    end
end

--------------------------------------------------
-- LOOP PRINCIPAL OPTIMIZADO
--------------------------------------------------
function StartAutoFarm()
    getgenv().Blackz.AutoFarm = true
    
    task.spawn(function()
        while getgenv().Blackz.AutoFarm do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                pcall(function()
                    -- Activar vuelo si está habilitado
                    if getgenv().Blackz.FlyMode then
                        EnableFlight()
                    end
                    
                    local npc = FindNearestNPC()
                    if npc then
                        if TeleportToNPC(npc) then
                            task.wait(0.15)
                            AttackNPC()
                            print("🎯 BLACKZ - Farmeando: " .. npc.Name)
                        end
                    else
                        print("🔍 BLACKZ - Buscando NPCs...")
                    end
                end)
            else
                print("💀 BLACKZ - Personaje muerto, esperando respawn...")
            end
            task.wait(0.3) -- Más rápido el loop
        end
    end)
end

