-- FUNCIONES ESPECÍFICAS PARA BRAINROT
function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function FindBrainrot()
    if not IsAlive(Character) then return nil end
    
    -- Buscar específicamente Brainrot
    for _, npc in pairs(Workspace.Enemies:GetChildren()) do
        if npc:IsA("Model") and IsAlive(npc) then
            -- Verificar si es Brainrot por nombre o atributos
            if string.find(npc.Name:lower(), "brainrot") or 
               string.find(npc.Name:lower(), "brain") or
               npc:GetAttribute("IsBrainrot") then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    return npc
                end
            end
        end
    end
    
    -- Buscar en NPCs también
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:IsA("Model") and IsAlive(npc) then
            if string.find(npc.Name:lower(), "brainrot") then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    return npc
                end
            end
        end
    end
    
    return nil
end

function FindNearestNPC()
    if not IsAlive(Character) then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    
    -- Priorizar Brainrot si está activado
    if Settings.TargetOnlyBrainrot then
        local brainrot = FindBrainrot()
        if brainrot then
            return brainrot
        end
    end
    
    -- Buscar otros enemigos
    for _, npc in pairs(Workspace.Enemies:GetChildren()) do
        if npc:IsA("Model") and IsAlive(npc) then
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local distance = (Root.Position - hrp.Position).Magnitude
                if distance < closestDistance and distance < 500 then
                    closestDistance = distance
                    closestNPC = npc
                end
            end
        end
    end
    
    return closestNPC
end

function TeleportTo(position)
    if not IsAlive(Character) then return false end
    if typeof(position) == "Instance" then
        position = position.Position
    end
    Root.CFrame = CFrame.new(position + Vector3.new(0, Settings.FarmDistance, 0))
    return true
end

function TeleportToNPC(npc)
    if not npc or not IsAlive(npc) then return false end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return TeleportTo(hrp.Position)
end

-- SISTEMA DE AUTO CLICK MEJORADO PARA BRAINROT
function StartAutoClick()
    if ClickConnection then
        ClickConnection:Disconnect()
        ClickConnection = nil
    end
    
    ClickConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoClick or not IsAlive(Character) then
            return
        end
        
        -- Click ultra-rápido para Brainrot
        for i = 1, 3 do  -- Triple click por frame
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.001)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
        
        task.wait(Settings.ClickSpeed)
    end)
end

function StopAutoClick()
    if ClickConnection then
        ClickConnection:Disconnect()
        ClickConnection = nil
    end
end

-- SISTEMA DE ATAQUE ESPECIAL PARA BRAINROT
function PerformBrainrotAttack()
    if not IsAlive(Character) then return end
    
    local tool = Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- Combinación especial de ataques para Brainrot
    local attackSequence = {"E", "R", "F", "T", "Y", "G"}
    
    for _, key in pairs(attackSequence) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.03)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.02)
    end
    
    -- Click adicional después de habilidades
    if Settings.AutoClick then
        for i = 1, 5 do
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.001)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end

-- HABILIDADES AUTOMÁTICAS MEJORADAS
function AutoHaki()
    if not Settings.AutoBuso then return end
    -- Buso Haki cada 5 segundos
    VirtualInput:SendKeyEvent(true, "Q", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Q", false, game)
end

function AutoKen()
    if not Settings.AutoKen then return end
    -- Ken Haki cada 3 segundos
    VirtualInput:SendKeyEvent(true, "Z", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Z", false, game)
end

-- MEJORAS DE PLAYER OPTIMIZADAS
function ApplyPlayerStats()
    if not IsAlive(Character) then return end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = Settings.WalkSpeed
        humanoid.JumpPower = Settings.JumpPower
    end
end

function ToggleNoclip()
    if Settings.Noclip then
        RunService.Stepped:Connect(function()
            if IsAlive(Character) then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

-- SISTEMA VISUAL MEJORADO
function ToggleFullBright()
    if Settings.FullBright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 3
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    else
        Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
    end
end

-- SISTEMA PRINCIPAL DE ROBO DE BRAINROT
function StartBrainrotSteal()
    if StealConnection then
        StealConnection:Disconnect()
        StealConnection = nil
    end
    
    Stealing = true
    StealConnection = RunService.Heartbeat:Connect(function()
        if not Settings.StealBrainrot or not IsAlive(Character) then
            return
        end
        
        -- Aplicar mejoras constantemente
        ApplyPlayerStats()
        
        -- Usar habilidades defensivas
        if Settings.AutoBuso then AutoHaki() end
        if Settings.AutoKen then AutoKen() end
        
        -- Buscar específicamente Brainrot
        local brainrot = FindBrainrot()
        
        if brainrot then
            BrainrotNPC = brainrot
            if TeleportToNPC(brainrot) then
                -- Ataque especializado para Brainrot
                PerformBrainrotAttack()
                
                -- Información de debug
                local humanoid = brainrot:FindFirstChildOfClass("Humanoid")
                local health = humanoid and math.floor(humanoid.Health) or "N/A"
                print("🧠 ATACANDO BRAINROT | Vida: " .. health)
            end
        else
            -- Si no encuentra Brainrot, buscar otros NPCs
            if not Settings.TargetOnlyBrainrot then
                local npc = FindNearestNPC()
                if npc then
                    if TeleportToNPC(npc) then
                        PerformBrainrotAttack()
                    end
                else
                    print("🔍 Buscando Brainrot...")
                end
            else
                print("🧠 Buscando exclusivamente Brainrot...")
            end
            BrainrotNPC = nil
        end
        
        task.wait(0.3)
    end)
end

function StopBrainrotSteal()
    Stealing = false
    if StealConnection then
        StealConnection:Disconnect()
        StealConnection = nil
    end
    BrainrotNPC = nil
end

