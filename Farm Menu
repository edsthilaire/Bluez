-- SCRIPT 5: CONFIGURACIÓN AVANZADA Y PROTECCIONES

-- Anti-AFK mejorado
local VirtualUser = game:GetService("VirtualUser")
game:GetService("Players").LocalPlayer.Idled:connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Protección contra detección
function SafeTeleport(cframe)
    pcall(function()
        LocalPlayer.Character.HumanoidRootPart.CFrame = cframe
    end)
end

-- Función segura para ataques
function SafeAttack()
    pcall(function()
        local attacks = {"E", "F", "R", "T"}
        for _, key in pairs(attacks) do
            VirtualInput:SendKeyEvent(true, key, false, game)
            wait(0.1)
            VirtualInput:SendKeyEvent(false, key, false, game)
            wait(0.1)
        end
    end)
end

-- Sistema de logs
function Log(message)
    print("[" .. os.date("%X") .. "] " .. message)
end

-- Verificador de seguridad
function IsSafe()
    if not LocalPlayer.Character then return false end
    if not LocalPlayer.Character:FindFirstChild("Humanoid") then return false end
    if LocalPlayer.Character.Humanoid.Health <= 0 then return false end
    return true
end

-- Inicialización segura
pcall(function()
    Log("Script iniciado correctamente")
    Log("Nivel del jugador: " .. GetPlayerLevel())
end)
