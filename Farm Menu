-- Functions
function StartAutoFarm()
    spawn(function()
        while getgenv().AutoFarmNPCs do
            pcall(function()
                local nearestNPC = FindNearestNPC()
                if nearestNPC then
                    TeleportToNPC(nearestNPC)
                    AttackNPC(nearestNPC)
                end
            end)
            wait(0.5)
        end
    end)
end

function StartBossFarm()
    spawn(function()
        while getgenv().AutoBossFarm do
            pcall(function()
                local boss = FindBoss()
                if boss then
                    TeleportToNPC(boss)
                    AttackNPC(boss)
                end
            end)
            wait(1)
        end
    end)
end

