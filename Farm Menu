-- BLACKZ HUB - Blox Fruits (Básico)
-- Script 100% funcional

-- Cargar la librería de interfaz
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()

-- Crear la ventana principal
local Window = Library.CreateLib("BLACKZ HUB - BLOX FRUITS", "DarkTheme")

-- Variables del script
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Running = false

-- Pestaña Principal
local MainTab = Window:NewTab("🏠 MAIN")
local MainSection = MainTab:NewSection("AUTO FARM")

MainSection:NewToggle("🚀 ACTIVAR AUTO FARM", "Inicia el farm automático", function(state)
    if state then
        Running = true
        StartAutoFarm()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "BLACKZ HUB",
            Text = "AUTO FARM ACTIVADO",
            Duration = 3
        })
    else
        Running = false
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "BLACKZ HUB",
            Text = "AUTO FARM DESACTIVADO",
            Duration = 3
        })
    end
end)

MainSection:NewToggle("🦅 MODO VUELO", "Volar sobre los NPCs", function(state)
    getgenv().FlyMode = state
end)

MainSection:NewToggle("🎯 ATAQUE A DISTANCIA", "Atacar desde lejos", function(state)
    getgenv().AttackDistance = state
end)

-- Pestaña de Configuración
local ConfigTab = Window:NewTab("⚙️ CONFIG")
local ConfigSection = ConfigTab:NewSection("AJUSTES")

ConfigSection:NewSlider("DISTANCIA", "Distancia del farm", 50, 10, function(value)
    getgenv().FarmDistance = value
end)

ConfigSection:NewSlider("VELOCIDAD", "Velocidad de movimiento", 100, 16, function(value)
    if LocalPlayer.Character and LocalPlayer.Character.Humanoid then
        LocalPlayer.Character.Humanoid.WalkSpeed = value
    end
end)

-- Pestaña de Teletransporte
local TeleportTab = Window:NewTab("🧭 TELEPORT")
local TeleportSection = TeleportTab:NewSection("ISLAS")

local islands = {
    {"Starter Island", CFrame.new(-100, 50, -100)},
    {"Jungle", CFrame.new(-1250, 70, -250)},
    {"Pirate Village", CFrame.new(-1150, 90, 3800)},
    {"Desert", CFrame.new(1000, 70, 4000)},
    {"Snow Mountain", CFrame.new(1300, 150, -1300)}
}

for i, island in pairs(islands) do
    TeleportSection:NewButton(island[1], function()
        if LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart then
            LocalPlayer.Character.HumanoidRootPart.CFrame = island[2]
        end
    end)
end

-- Pestaña de Información
local InfoTab = Window:NewTab("📊 INFO")
local InfoSection = InfoTab:NewSection("INFORMACIÓN")

InfoSection:NewLabel("BLACKZ HUB v1.0")
InfoSection:NewLabel("Por Blackz Team")
InfoSection:NewButton("ACTUALIZAR", function()
    print("BLACKZ HUB - Actualizado")
end)

InfoSection:NewKeybind("TOGGLE MENU", "Mostrar/ocultar menú", Enum.KeyCode.RightControl, function()
    Library:ToggleUI()
end)

-- Función principal de Auto Farm
function StartAutoFarm()
    spawn(function()
        while Running do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                -- Buscar NPCs cercanos
                for _, npc in pairs(workspace.NPCs:GetChildren()) do
                    if not Running then break end
                    
                    if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                        if npc:FindFirstChild("HumanoidRootPart") then
                            -- Teletransportarse al NPC
                            local distance = getgenv().FarmDistance or 25
                            local targetPos = npc.HumanoidRootPart.Position + Vector3.new(0, distance, 0)
                            
                            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
                            
                            -- Atacar
                            if getgenv().AttackDistance then
                                game:GetService("VirtualInputManager"):SendKeyEvent(true, "E", false, game)
                                wait(0.1)
                                game:GetService("VirtualInputManager"):SendKeyEvent(false, "E", false, game)
                                
                                game:GetService("VirtualInputManager"):SendKeyEvent(true, "F", false, game)
                                wait(0.1)
                                game:GetService("VirtualInputManager"):SendKeyEvent(false, "F", false, game)
                            end
                            
                            wait(0.5)
                        end
                    end
                end
            end
            wait(1)
        end
    end)
end

-- Mensaje de inicio
print("====================================")
print("BLACKZ HUB - CARGADO EXITOSAMENTE!")
print("Presiona RightControl para el menú")
print("====================================")

-- Notificación de inicio
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "BLACKZ HUB",
    Text = "Script cargado correctamente!",
    Duration = 5
})

