--------------------------------------------------
-- SISTEMA DE DETECCIÓN DE NIVEL Y QUESTS
--------------------------------------------------
function GetPlayerLevel()
    local stats = Plr:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 1
end

function GetRecommendedQuestNPC()
    local playerLevel = GetPlayerLevel()
    
    -- Asignar NPCs según nivel (simplificado)
    if playerLevel < 15 then
        return "BanditQuest1", "Bandit Quest Giver"
    elseif playerLevel < 30 then
        return "JungleQuest", "Adventurer"
    elseif playerLevel < 60 then
        return "BuggyQuest1", "Pirate Adventurer"
    elseif playerLevel < 90 then
        return "DesertQuest", "Desert Adventurer"
    elseif playerLevel < 120 then
        return "SnowQuest", "Villager"
    elseif playerLevel < 150 then
        return "MarineQuest2", "Marine"
    elseif playerLevel < 200 then
        return "PrisonerQuest", "Jail Keeper"
    elseif playerLevel < 300 then
        return "MagmaQuest", "The Mayor"
    else
        return "FishmanQuest", "King Neptune"
    end
end

--------------------------------------------------
-- BUSCAR NPC EN EL MAPA
--------------------------------------------------
function FindNPC(npcName)
    local closestNPC = nil
    local shortestDistance = math.huge
    
    -- Buscar en todo el workspace
    for _, npc in pairs(WS:GetChildren()) do
        if npc:IsA("Model") then
            -- Verificar si coincide el nombre
            if string.find(npc.Name:lower(), npcName:lower()) or 
               (npc:FindFirstChild("Humanoid") and npc:FindFirstChild("Head") and 
                npc.Head:FindFirstChild("Dialog")) then
                
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local distance = (Root.Position - hrp.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestNPC = npc
                    end
                end
            end
        end
    end
    
    return closestNPC
end

--------------------------------------------------
-- CLICS ULTRA RÁPIDOS MEJORADOS
--------------------------------------------------
function UltraFastClicks()
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local center = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
    
    -- Hacer 15 clics ultra rápidos
    for i = 1, 15 do
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        task.wait(0.01)
    end
end

--------------------------------------------------
-- TELETRANSPORTE PRECISO
--------------------------------------------------
function TeleportToNPC(npc)
    if not (npc and npc.Parent and Root and Root.Parent) then return false end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Teletransportarse encima del NPC
    Root.CFrame = hrp.CFrame + Vector3.new(0, Config.FarmDistance, 0)
    return true
end

--------------------------------------------------
-- ACEPTAR QUEST AUTOMÁTICAMENTE
--------------------------------------------------
function AcceptQuest(npc)
    if not npc then return false end
    
    -- Buscar diálogo para aceptar quest
    local head = npc:FindFirstChild("Head")
    if head then
        local dialog = head:FindFirstChild("Dialog")
        if dialog then
            -- Simular interacción con el NPC
            fireproximityprompt(dialog)
            print("📜 Quest aceptado de: " .. npc.Name)
            return true
        end
    end
    
    return false
end

--------------------------------------------------
-- SISTEMA PRINCIPAL DE FARM
--------------------------------------------------
function StartNPCAutoFarm()
    Config.AutoFarm = true
    
    while Config.AutoFarm do
        if not (Plr.Character and Plr.Character.Humanoid.Health > 0) then
            print("💀 Personaje muerto, esperando respawn...")
            task.wait(3)
            continue
        end
        
        -- Obtener NPC recomendado para el nivel
        local questName, npcName = GetRecommendedQuestNPC()
        local playerLevel = GetPlayerLevel()
        
        print("🎯 NIVEL " .. playerLevel .. " | QUEST: " .. questName)
        print("🔍 Buscando NPC: " .. npcName)
        
        -- Buscar el NPC
        local npc = FindNPC(npcName)
        
        if npc then
            print("✅ NPC ENCONTRADO: " .. npc.Name)
            
            -- Teletransportarse al NPC
            if TeleportToNPC(npc) then
                task.wait(0.5)
                
                -- Intentar aceptar quest
                AcceptQuest(npc)
                
                -- Hacer clics rápidos (para interactuar/atacar)
                local clickCount = 0
                while Config.AutoFarm do
                    UltraFastClicks()
                    clickCount = clickCount + 1
                    
                    -- Mostrar progreso
                    if clickCount % 3 == 0 then
                        print("🖱️ Ciclo de clics: " .. clickCount)
                    end
                    
                    -- Cambiar de NPC después de varios ciclos
                    if clickCount >= 10 then
                        break
                    end
                    
                    task.wait(0.5)
                end
            end
        else
            print("❌ NPC no encontrado: " .. npcName)
            print("📍 Posición actual: " .. tostring(Root.Position))
        end
        
        task.wait(1)
    end
end

