-- FUNCIÓN PARA OBTENER NIVEL
function GetPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 1
end

-- FUNCIÓN PARA VOLAR SOBRE NPCS
function EnableFlight()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    -- Crear efecto de vuelo
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 25, 0)
    bodyVelocity.MaxForce = Vector3.new(0, 100000, 0)
    bodyVelocity.Parent = character.HumanoidRootPart
    
    -- Mantener altura
    character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, Settings.FarmDistance, 0)
    
    return bodyVelocity
end

-- FUNCIÓN BUSCAR NPC MÁS CERCANO
function FindNearestNPC()
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc:FindFirstChild("HumanoidRootPart") then
            local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance and distance < Settings.AttackRange then
                closestDistance = distance
                closestNPC = npc
            end
        end
    end
    
    return closestNPC, closestDistance
end

-- FUNCIÓN ATACAR DESDE LEJOS
function AttackFromDistance(npc)
    if not npc then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Posición de ataque segura
    local npcPos = npc.HumanoidRootPart.Position
    local attackPos = npcPos + Vector3.new(0, Settings.FarmDistance, 0)
    
    -- Teletransportarse a posición de ataque
    character.HumanoidRootPart.CFrame = CFrame.new(attackPos)
    
    -- Ejecutar todos los ataques
    local attackKeys = {"E", "F", "R", "T", "Y", "G", "H"}
    
    for _, key in pairs(attackKeys) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.05)
    end
end

-- FUNCIÓN ACEPTAR MISIONES
function AcceptQuests()
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Head") and npc.Head:FindFirstChild("Dialog") then
            local distance = (LocalPlayer.Character.HumanoidRootPart.Position - npc.HumanoidRootPart.Position).Magnitude
            if distance < 25 then
                fireproximityprompt(npc.Head.Dialog, 1)
                task.wait(1)
            end
        end
    end
end

-- FUNCIÓN VERIFICAR NUEVA ISLA
function CheckNewIsland()
    local currentLevel = GetPlayerLevel()
    
    for i, island in pairs(Islands) do
        if currentLevel >= island.Level then
            if i < #Islands and currentLevel < Islands[i + 1].Level then
                return island
            elseif i == #Islands then
                return island
            end
        end
    end
    return Islands[1] -- Isla inicial por defecto
end

-- FUNCIÓN IR A NUEVA ISLA
function GoToNewIsland(island)
    if not island then return end
    
    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(island.Position)
    print("🏝️ Teletransportado a: " .. island.Name .. " (Nivel " .. island.Level .. ")")
    task.wait(3)
end

-- FUNCIÓN FARM AUTOMÁTICO
function StartAutoFarm()
    getgenv().FarmConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoFarm then
            getgenv().FarmConnection:Disconnect()
            return
        end
        
        if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
            pcall(function()
                -- Activar vuelo si está habilitado
                if Settings.FlyAboveNPCs then
                    EnableFlight()
                end
                
                -- Buscar y atacar NPCs
                local npc, distance = FindNearestNPC()
                
                if npc then
                    AttackFromDistance(npc)
                else
                    -- Si no hay NPCs, cambiar de isla automáticamente
                    if Settings.AutoNewIsland then
                        local newIsland = CheckNewIsland()
                        if newIsland then
                            GoToNewIsland(newIsland)
                        end
                    end
                end
                
                -- Aceptar misiones automáticamente
                if Settings.AutoQuest then
                    AcceptQuests()
                end
            end)
        end
    end)
end

