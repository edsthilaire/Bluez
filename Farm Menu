    Sea1 = Workspace:WaitForChild("Enemies"),
    Sea2 = Workspace:WaitForChild("Enemies"),
    Sea3 = Workspace:WaitForChild("Enemies")
}

local Enemies = EnemyFolders[CurrentSea] or Workspace:WaitForChild("Enemies")

-- ⚙️ CONFIG
local Config = {
    AutoFarm = false,
    FarmDistance = 15,
    AttackDelay = 0.12,
    SelectedSea = CurrentSea
}

-- 🔄 BUSCAR NPCs
function FindNearestEnemy()
    if not (LPlayer.Character and RootPart) then return nil end
    local closest, dist = nil, math.huge
    local myPos = RootPart.Position

    for _, npc in ipairs(Enemies:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0
           and npc:FindFirstChild("HumanoidRootPart") then
            local d = (myPos - npc.HumanoidRootPart.Position).Magnitude
            if d < dist then
                closest, dist = npc, d
            end
        end
    end
    return closest
end

-- 🎯 TELEPORT
function TeleportToNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return false end
    local np = npc.HumanoidRootPart.Position
    RootPart.CFrame = CFrame.new(np + Vector3.new(math.random(-2,2), Config.FarmDistance, math.random(-2,2)))
    return true
end

-- ⚔️ ATACAR
function Attack()
    local keys = {"E","F","R","T"}
    for _, k in ipairs(keys) do
        if not Config.AutoFarm then break end
        VirtualInput:SendKeyEvent(true,  k, false, game)
        task.wait(Config.AttackDelay)
        VirtualInput:SendKeyEvent(false, k, false, game)
        task.wait(Config.AttackDelay)
    end
end

-- 🔁 LOOP AUTO-FARM
function StartAutoFarm()
    Config.AutoFarm = true
    task.spawn(function()
        while Config.AutoFarm do
            local npc = FindNearestEnemy()
            if npc then
                if TeleportToNPC(npc) then
                    task.wait(0.2)
                    Attack()
                end
            else
                task.wait(0.5)
            end
            task.wait(0.5)
        end
    end)
end

