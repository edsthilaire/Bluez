local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local WS = game:GetService("Workspace")
local Plr = Players.LocalPlayer
local Root = Plr.Character:WaitForChild("HumanoidRootPart")

local Config = {
    AutoFarm = false,
    FarmDistance = 16,
    AttackDelay = 0.12,
    StuckCheckDelay = 1,
    StuckThreshold = 2,
}

--------------------------------------------------
-- FUNCIONES PRINCIPALES
--------------------------------------------------
local function isInWater(pos)
    local ray = Ray.new(pos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0))
    local part = workspace:FindPartOnRay(ray, nil, false, true)
    return part and part.Material == Enum.Material.Water
end

local function getNearest()
    if not (Root and Root.Parent) then return nil end
    local near, dist = nil, math.huge
    for _, v in ipairs(WS.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if hrp and not isInWater(hrp.Position) then
                local d = (Root.Position - hrp.Position).Magnitude
                if d < dist then
                    near, dist = v, d
                end
            end
        end
    end
    return near
end

local function tpAttack(npc)
    if not (npc and npc.Parent and Root and Root.Parent) then return end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    Root.CFrame = hrp.CFrame + Vector3.new(0, Config.FarmDistance, 0)
    task.wait(0.2)

    for _, k in ipairs({"E","F","R","T"}) do
        if not (npc and npc.Parent) then break end
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(Config.AttackDelay)
        VIM:SendKeyEvent(false, k, false, game)
        task.wait(Config.AttackDelay)
    end
end

--------------------------------------------------
-- ANTI-ATASCOS AGRESIVO
--------------------------------------------------
local lastPos = Root.Position
local stuckCount = 0
task.spawn(function()
    while task.wait(Config.StuckCheckDelay) do
        if not Config.AutoFarm then continue end

        local movedDist = (Root.Position - lastPos).Magnitude
        if movedDist < Config.StuckThreshold then
            stuckCount += 1
            local elevate = math.random(8 + stuckCount*4, math.min(stuckCount*12+20,40))
            local push = Vector3.new(math.random(-6,6), elevate, math.random(-6,-14))
            Root.CFrame = Root.CFrame + push
            if stuckCount > 6 then
                Root.CFrame = CFrame.new(Root.Position + Vector3.new(math.random(-30,30),100,-math.random(40,80)))
                stuckCount = 0
            end
        else
            stuckCount = math.max(stuckCount-1,0)
        end
        if stuckCount > 10 then
            Root.CFrame = CFrame.new(Root.Position + Vector3.new(math.random(-30,30),120,-math.random(60,120)))
            stuckCount = 0
        end
        lastPos = Root.Position
    end
end)

