-- CONFIG
getgenv().Blackz = {
    AutoFarm = false,
    FarmDistance = 15,       -- altura sobre el NPC
    WalkSpeed  = 35,
    JumpPower  = 50
}

--------------------------------------------------
-- 1) 🔄 BUSCAR NPCs AUTOMÁTICAMENTE
--------------------------------------------------
function FindNearestNPC()
    if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then
        return nil
    end
    local closestNPC, closestDist = nil, math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position

    -- Cambia "NPCs" por "Enemies" u otra carpeta si tu juego usa otra
    for _, npc in pairs(Workspace:GetDescendants()) do
        if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0
           and npc:FindFirstChild("HumanoidRootPart") then
            local dist = (playerPos - npc.HumanoidRootPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestNPC  = npc
            end
        end
    end
    return closestNPC
end

--------------------------------------------------
-- 2) 🎯 TELETRANSPORTARSE AL NPC
--------------------------------------------------
function TeleportToNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return false end
    local root = LocalPlayer.Character.HumanoidRootPart
    local np   = npc.HumanoidRootPart.Position
    -- pequeño random para evitar CFrame-snapping
    root.CFrame = CFrame.new(np + Vector3.new(math.random(-2,2), getgenv().Blackz.FarmDistance, math.random(-2,2)))
    return true
end

--------------------------------------------------
-- 3) ⚔️ ATACAR CON E, F, R, T
--------------------------------------------------
function AttackNPC()
    local keys = {"E","F","R","T"}
    for _, key in ipairs(keys) do
        if not getgenv().Blackz.AutoFarm then break end
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.12)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.12)
    end
end

--------------------------------------------------
-- LOOP PRINCIPAL
--------------------------------------------------
function StartAutoFarm()
    getgenv().Blackz.AutoFarm = true
    task.spawn(function()
        while getgenv().Blackz.AutoFarm do
            pcall(function()
                local npc = FindNearestNPC()      -- 🔄
                if npc then
                    if TeleportToNPC(npc) then    -- 🎯
                        task.wait(0.2)
                        AttackNPC()               -- ⚔️
                        print("🎯 Farmeando: "..npc.Name)
                    end
                else
                    print("🔍 Buscando NPCs...")
                end
            end)
            task.wait(0.5)
        end
    end)
end

