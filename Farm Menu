--⚡ BLACKZ AUTO-FARM "ATAQUES INVISIBLES" – SEA-1
-- Teleporta ENCIMA del NPC → spam remoto → sin mover la patita
local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local WS = game:GetService("Workspace")

local Plr = Players.LocalPlayer
local Root = Plr.Character:WaitForChild("HumanoidRootPart")

local Config = {
    AutoFarm = false,
    FarmDistance = 10,          -- altura sobre la cabeza del NPC
    AttackDelay = 0,            -- SIN delay entre teclas (spam)
    StuckCheckDelay = 1,
    StuckThreshold = 2,
}

--------------------------------------------------
-- ATAQUES "INVISIBLES" A DISTANCIA
--------------------------------------------------
local function spamAttack()
    -- dispara las 4 teclas casi al mismo tiempo
    for _, k in ipairs({"E","F","R","T"}) do
        VIM:SendKeyEvent(true, k, false, game)
        VIM:SendKeyEvent(false, k, false, game)
    end
end

--------------------------------------------------
-- BUSCA NPC
--------------------------------------------------
local function getNearest()
    if not (Root and Root.Parent) then return nil end
    local near, dist = nil, math.huge
    for _, v in ipairs(WS.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (Root.Position - hrp.Position).Magnitude
                if d < dist then near, dist = v, d end
            end
        end
    end
    return near
end

--------------------------------------------------
-- TELEPORTA ENCIMA + SPAM ATAQUES
--------------------------------------------------
local function tpSpam(npc)
    if not (npc and npc.Parent and Root and Root.Parent) then return end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Siempre ENCIMA (sin tocar suelo)
    Root.CFrame = hrp.CFrame + Vector3.new(0, Config.FarmDistance, 0)

    -- Muchos ataques por segundo (sin delay)
    for i = 1, 12 do          -- 12 "rafagas" rápidas
        if not (npc and npc.Parent) then break end
        spamAttack()
        task.wait(0.02)       -- apenas 20 ms entre ráfagas
    end
end

--------------------------------------------------
-- ANTI-ATASCOS AGRESIVO
--------------------------------------------------
local lastPos = Root.Position
local stuckCount = 0
task.spawn(function()
    while task.wait(Config.StuckCheckDelay) do
        if not Config.AutoFarm then continue end
        local moved = (Root.Position - lastPos).Magnitude
        if moved < Config.StuckThreshold then
            stuckCount += 1
            local push = Vector3.new(math.random(-8,8), math.random(20,45), math.random(-10,-20))
            Root.CFrame = Root.CFrame + push
            if stuckCount > 5 then
                Root.CFrame = CFrame.new(Root.Position + Vector3.new(math.random(-40,40),120,-math.random(60,120)))
                stuckCount = 0
            end
        else
            stuckCount = 0
        end
        lastPos = Root.Position
    end
end)

--------------------------------------------------
-- UI RÁPIDA
--------------------------------------------------
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("⚡ BLACKZ ATAQUES INVISIBLES","DarkTheme")
local Tab = Window:NewTab("Farm")
local Sec = Tab:NewSection("Control")

Sec:NewToggle("🚀 Activar Auto-Farm","",function(s)
    Config.AutoFarm = s
    while Config.AutoFarm do
        tpSpam(getNearest())
        task.wait(0.25)     -- pequeña pausa entre NPCs
    end
end)

Sec:NewSlider("📏 Altura sobre NPC","",50,5,function(v)
    Config.FarmDistance = v
end)

