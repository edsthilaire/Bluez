-- ⚡ BLACKZ AUTO-FARM ULTRA - TELEPORT + ATAQUES INVISIBLES
-- Teletransporta encima del NPC | Ataques desde lejos | Máxima velocidad

local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local WS = game:GetService("Workspace")
local Plr = Players.LocalPlayer

repeat task.wait() until Plr.Character
local Root = Plr.Character:WaitForChild("HumanoidRootPart")

local Config = {
    AutoFarm = true,  -- Activado por defecto
    FarmDistance = 25, -- Altura sobre NPC
    AttackSpeed = 0.05, -- Máxima velocidad de ataque
    TeleportSpeed = 0.1,
}

-- Lista de NPCs asesinados recientemente
local KilledNPCs = {}

--------------------------------------------------
-- FUNCIÓN BUSCAR NPC MÁS CERCANO Y VIVO
--------------------------------------------------
local function getNearestAliveNPC()
    if not (Root and Root.Parent) then return nil end
    
    local nearestNPC = nil
    local shortestDistance = math.huge
    local playerPos = Root.Position
    
    -- Buscar en todas las ubicaciones posibles
    local searchFolders = {"Enemies", "NPCs", "Monsters", "Bandits", "Pirates"}
    
    for _, folderName in pairs(searchFolders) do
        local folder = WS:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and not KilledNPCs[npc] then
                    local humanoid = npc:FindFirstChild("Humanoid")
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    
                    if humanoid and hrp and humanoid.Health > 0 then
                        local distance = (playerPos - hrp.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            nearestNPC = npc
                        end
                    elseif humanoid and humanoid.Health <= 0 then
                        -- Marcar NPC como muerto
                        KilledNPCs[npc] = true
                    end
                end
            end
        end
    end
    
    -- Si no encuentra en carpetas, buscar en todo Workspace
    if not nearestNPC then
        for _, npc in pairs(WS:GetChildren()) do
            if npc:IsA("Model") and not KilledNPCs[npc] then
                local humanoid = npc:FindFirstChild("Humanoid")
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                
                if humanoid and hrp and humanoid.Health > 0 then
                    -- Filtrar NPCs reales (no jugadores)
                    if not Players:GetPlayerFromCharacter(npc) then
                        local distance = (playerPos - hrp.Position).Magnitude
                        if distance < shortestDistance and distance < 500 then
                            shortestDistance = distance
                            nearestNPC = npc
                        end
                    end
                elseif humanoid and humanoid.Health <= 0 then
                    KilledNPCs[npc] = true
                end
            end
        end
    end
    
    return nearestNPC
end

--------------------------------------------------
-- TELETRANSPORTE INSTANTÁNEO ENCIMA DEL NPC
--------------------------------------------------
local function teleportAboveNPC(npc)
    if not (npc and npc.Parent and Root and Root.Parent) then return false end
    
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Teletransportarse directamente encima del NPC
    local targetPosition = hrp.Position + Vector3.new(0, Config.FarmDistance, 0)
    Root.CFrame = CFrame.new(targetPosition)
    
    return true
end

--------------------------------------------------
-- ATAQUES ULTRA RÁPIDOS DESDE LEJOS (INVISIBLES)
--------------------------------------------------
local function ultraFastAttack()
    -- Todas las teclas de ataque posibles
    local attackKeys = {"E", "F", "R", "T", "Y", "G", "H", "X", "C", "V", "B", "N"}
    
    -- Ejecutar múltiples ataques simultáneamente
    for _, key in pairs(attackKeys) do
        VIM:SendKeyEvent(true, key, false, game)
    end
    
    task.wait(Config.AttackSpeed)
    
    -- Soltar todas las teclas
    for _, key in pairs(attackKeys) do
        VIM:SendKeyEvent(false, key, false, game)
    end
end

--------------------------------------------------
-- ATAQUES DE RANGO LARGO (SIN MOVERSE)
--------------------------------------------------
local function longRangeAttack(npc)
    if not npc then return end
    
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Ataques especiales de largo alcance
    local longRangeKeys = {"R", "T", "Y", "G", "H"} -- Habilidades de rango
    
    for _, key in pairs(longRangeKeys) do
        VIM:SendKeyEvent(true, key, false, game)
        task.wait(0.02)
        VIM:SendKeyEvent(false, key, false, game)
        task.wait(0.02)
    end
end

--------------------------------------------------
-- SISTEMA DE FARM AUTOMÁTICO MEJORADO
--------------------------------------------------
local function advancedFarm()
    while Config.AutoFarm do
        if Plr.Character and Plr.Character.Humanoid.Health > 0 then
            local npc = getNearestAliveNPC()
            
            if npc then
                local hrp = npc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Teletransportarse encima del NPC
                    teleportAboveNPC(npc)
                    
                    -- Ataques ultra rápidos
                    ultraFastAttack()
                    
                    -- Ataques de largo alcance adicionales
                    longRangeAttack(npc)
                    
                    -- Verificar si el NPC murió
                    if npc.Humanoid.Health <= 0 then
                        KilledNPCs[npc] = true
                        print("🎯 NPC ELIMINADO: " .. npc.Name)
                    else
                        print("⚡ Atacando: " .. npc.Name .. " | Vida: " .. math.floor(npc.Humanoid.Health))
                    end
                end
            else
                print("🔍 Buscando nuevos NPCs...")
                -- Limpiar lista de NPCs muertos si no hay objetivos
                if math.random(1, 10) == 1 then
                    table.clear(KilledNPCs)
                end
            end
        else
            print("💀 Personaje muerto - Esperando respawn...")
        end
        
        task.wait(Config.TeleportSpeed)
    end
end

--------------------------------------------------
-- INTERFAZ SIMPLE Y EFECTIVA
--------------------------------------------------
local function createSimpleUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Parent = game.CoreGui
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 300, 0, 200)
    MainFrame.Position = UDim2.new(0.5, -150, 0.5, -100)
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    MainFrame.BorderSizePixel = 0
    MainFrame.Parent = ScreenGui
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 40)
    Title.Position = UDim2.new(0, 0, 0, 0)
    Title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Title.Text = "⚡ BLACKZ ULTRA FARM"
    Title.TextColor3 = Color3.fromRGB(0, 255, 255)
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 20
    Title.Parent = MainFrame
    
    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(1, 0, 0, 30)
    StatusLabel.Position = UDim2.new(0, 0, 0, 40)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = "Estado: ACTIVADO"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    StatusLabel.Font = Enum.Font.SourceSans
    StatusLabel.TextSize = 16
    StatusLabel.Parent = MainFrame
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0.8, 0, 0, 40)
    ToggleBtn.Position = UDim2.new(0.1, 0, 0, 100)
    ToggleBtn.Text = "⛔ DETENER FARM"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    ToggleBtn.Parent = MainFrame
    
    ToggleBtn.MouseButton1Click:Connect(function()
        Config.AutoFarm = not Config.AutoFarm
        if Config.AutoFarm then
            ToggleBtn.Text = "⛔ DETENER FARM"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            StatusLabel.Text = "Estado: ACTIVADO"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            advancedFarm()
        else
            ToggleBtn.Text = "🚀 ACTIVAR FARM"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            StatusLabel.Text = "Estado: DETENIDO"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)
    
    return ScreenGui
end

--------------------------------------------------
-- INICIALIZACIÓN
--------------------------------------------------
print("⚡ BLACKZ ULTRA FARM CARGADO!")
print("🎯 Teletransporte encima de NPCs")
print("⚡ Ataques ultra rápidos desde lejos")
print("🚀 Activado automáticamente")

-- Crear interfaz
createSimpleUI()

-- Iniciar farm automáticamente
task.spawn(advancedFarm)

-- Anti-AFK
Plr.Idled:Connect(function()
    game:GetService("VirtualUser"):ClickButton2(Vector2.new())
end)

-- Limpiar memoria periódicamente
task.spawn(function()
    while true do
        task.wait(30)
        local count = 0
        for k, v in pairs(KilledNPCs) do
            count = count + 1
            if count > 50 then  -- Limitar tamaño de la tabla
                KilledNPCs[k] = nil
            end
        end
    end
end)
