--------------------------------------------------
-- FIX: Kavo UI (para que el menú siempre aparezca)
--------------------------------------------------

local Library
pcall(function()
    Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
end)

if not Library then
    -- Si falla la carga online, crea una UI básica local
    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    local Frame = Instance.new("Frame", ScreenGui)
    Frame.Size = UDim2.new(0, 300, 0, 150)
    Frame.Position = UDim2.new(0.5, -150, 0.5, -75)
    Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Frame.BorderSizePixel = 0

    local Title = Instance.new("TextLabel", Frame)
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundTransparency = 1
    Title.Text = "🌊 SEA-1 AUTO-FARM"
    Title.TextColor3 = Color3.fromRGB(0, 255, 255)
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 22

    local ToggleBtn = Instance.new("TextButton", Frame)
    ToggleBtn.Position = UDim2.new(0.1, 0, 0.5, -15)
    ToggleBtn.Size = UDim2.new(0.8, 0, 0, 30)
    ToggleBtn.Text = "🚀 Activar Auto-Farm"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ToggleBtn.MouseButton1Click:Connect(function()
        Config.AutoFarm = not Config.AutoFarm
        ToggleBtn.Text = Config.AutoFarm and "⛔ Detener Auto-Farm" or "🚀 Activar Auto-Farm"
        while Config.AutoFarm do
            tpAttack(getNearest())
            task.wait(0.4)
        end
    end)
else
    -- Si carga bien la biblioteca, usa tu código original de Kavo
    local Window = Library.CreateLib("🌊 SEA-1 COMPLETO", "DarkTheme")
    local Tab = Window:NewTab("Farm")
    local Sec = Tab:NewSection("Control")

    Sec:NewToggle("🚀 Activar Auto-Farm","",function(s)
        Config.AutoFarm = s
        while Config.AutoFarm do
            tpAttack(getNearest())
            task.wait(0.4)
        end
    end)

    Sec:NewSlider("📏 Distancia","",50,10,function(v)
        Config.FarmDistance = v
    end)
end

