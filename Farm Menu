-- Script que SÍ funciona

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local VirtualInput = game:GetService("VirtualInputManager")

-- CONFIGURACIÓN
getgenv().BlackzSettings = {
    AutoFarm = false,
    FlyMode = true,
    AttackFromDistance = true,
    AutoNewIsland = true,
    FarmDistance = 25,
    WalkSpeed = 50,
    JumpPower = 50
}

-- FUNCIÓN PARA OBTENER NIVEL
function GetPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 1
end

-- FUNCIÓN VOLAR SOBRE NPCs
function EnableFlight()
    if not BlackzSettings.FlyMode then return end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, BlackzSettings.FarmDistance, 0)
    end
end

-- FUNCIÓN BUSCAR NPC MÁS CERCANO
function FindNearestNPC()
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc:FindFirstChild("HumanoidRootPart") then
            local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestNPC = npc
            end
        end
    end
    
    return closestNPC, closestDistance
end

-- FUNCIÓN ATAQUE MEJORADO
function AdvancedAttack(npc)
    if not npc then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Teletransportarse a posición de ataque
    local npcPos = npc.HumanoidRootPart.Position
    local attackPos = npcPos + Vector3.new(0, BlackzSettings.FarmDistance, 0)
    char.HumanoidRootPart.CFrame = CFrame.new(attackPos)
    
    -- Ejecutar combo de ataques
    local attacks = {"E", "F", "R", "T", "Y"}
    
    for i = 1, 2 do
        for _, key in pairs(attacks) do
            if not BlackzSettings.AutoFarm then break end
            
            VirtualInput:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInput:SendKeyEvent(false, key, false, game)
            task.wait(0.1)
        end
        task.wait(0.5)
    end
end

-- FUNCIÓN PRINCIPAL DE FARM
function StartAutoFarm()
    BlackzSettings.AutoFarm = true
    
    coroutine.wrap(function()
        while BlackzSettings.AutoFarm do
            if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
                pcall(function()
                    -- Buscar NPC más cercano
                    local npc, distance = FindNearestNPC()
                    
                    if npc then
                        -- Activar vuelo
                        if BlackzSettings.FlyMode then
                            EnableFlight()
                        end
                        
                        -- Atacar NPC
                        if BlackzSettings.AttackFromDistance then
                            AdvancedAttack(npc)
                        end
                    else
                        -- Si no hay NPCs, buscar en otra área
                        print("🔍 Buscando NPCs...")
                    end
                end)
            end
            wait(0.5)
        end
    end)()
end

