--⚡ BLACKZ "CLIC-MUERTE-TP" – SEA-1
-- Clic invisible en pantalla → mata → MUERE → TP al siguiente
local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local WS = game:GetService("Workspace")

local Plr = Players.LocalPlayer
local Root = Plr.Character:WaitForChild("HumanoidRootPart")

local Config = { AutoFarm = false }

--------------------------------------------------
-- CLIC EN PANTALLA GRANDE (sin apuntar)
--------------------------------------------------
local function bigClick()
    -- clic izquierdo DOWN + UP en el centro de la pantalla
    local center = Vector2.new(workspace.CurrentCamera.ViewportSize.X/2,
                               workspace.CurrentCamera.ViewportSize.Y/2)
    VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
    task.wait()
    VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
end

--------------------------------------------------
-- BUSCA NPC VÁLIDO
--------------------------------------------------
local function getNearest()
    if not (Root and Root.Parent) then return nil end
    local near, dist = nil, math.huge
    for _, v in ipairs(WS.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (Root.Position - hrp.Position).Magnitude
                if d < dist then near, dist = v, d end
            end
        end
    end
    return near
end

--------------------------------------------------
-- LOOP: CLICAR HASTA QUE MUERA → LUEGO TP
--------------------------------------------------
local function clicDeathTp()
    Config.AutoFarm = true
    while Config.AutoFarm do
        local npc = getNearest()
        if npc then
            local humanoid = npc:FindFirstChild("Humanoid")
            -- clicar rápidamente hasta que muera
            while humanoid and humanoid.Health > 0 and Config.AutoFarm do
                bigClick()
                task.wait(0.03)   -- 30 clics/seg aprox
            end
            -- MUERTO → teleporta al siguiente
            if Config.AutoFarm then
                local nextNpc = getNearest()
                if nextNpc then
                    Root.CFrame = nextNpc.HumanoidRootPart.CFrame + Vector3.new(0,10,0)
                end
            end
        end
        task.wait(0.2)
    end
end

--------------------------------------------------
-- UI MÍNIMA
--------------------------------------------------
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("🖱️ BLACKZ CLIC-MUERTE-TP","DarkTheme")
local Tab = Window:NewTab("Farm")
local Sec = Tab:NewSection("Control")

Sec:NewToggle("🔥 Activar Clic-Muerte-TP","",function(s)
    Config.AutoFarm = s
    if s then clicDeathTp() end
end)

