--------------------------------------------------
-- SISTEMA INTELIGENTE DE QUESTS
--------------------------------------------------
function GetPlayerLevel()
    local stats = Plr:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 1
end

function GetRecommendedQuest()
    local playerLevel = GetPlayerLevel()
    local bestQuest = nil
    local highestLevel = 0
    
    -- Buscar el quest más apropiado para el nivel
    for questName, questStages in pairs(QuestData) do
        for _, stage in ipairs(questStages) do
            if playerLevel >= stage.LevelReq and stage.LevelReq > highestLevel then
                highestLevel = stage.LevelReq
                bestQuest = {
                    QuestName = questName,
                    Stage = stage,
                    EnemyName = next(stage.Task) -- Primer enemigo del task
                }
            end
        end
    end
    
    return bestQuest
end

--------------------------------------------------
-- BUSCAR NPC ESPECÍFICO DEL QUEST
--------------------------------------------------
function FindQuestNPC(enemyName)
    local closestNPC = nil
    local shortestDistance = math.huge
    
    -- Buscar en todas las ubicaciones posibles
    local searchFolders = {"Enemies", "NPCs", "Monsters"}
    
    for _, folderName in pairs(searchFolders) do
        local folder = WS:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                    -- Buscar por nombre del enemigo del quest
                    if string.find(npc.Name:lower(), enemyName:lower()) then
                        local hrp = npc:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local distance = (Root.Position - hrp.Position).Magnitude
                            if distance < shortestDistance then
                                shortestDistance = distance
                                closestNPC = npc
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Si no encuentra en carpetas, buscar en todo Workspace
    if not closestNPC then
        for _, npc in pairs(WS:GetChildren()) do
            if npc:IsA("Model") and npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                if string.find(npc.Name:lower(), enemyName:lower()) then
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local distance = (Root.Position - hrp.Position).Magnitude
                        if distance < shortestDistance and distance < 500 then
                            shortestDistance = distance
                            closestNPC = npc
                        end
                    end
                end
            end
        end
    end
    
    return closestNPC
end

--------------------------------------------------
-- CLICS ULTRA RÁPIDOS
--------------------------------------------------
function UltraFastClicks()
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local center = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
    
    -- Hacer 10 clics ultra rápidos
    for i = 1, 10 do
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
        task.wait(0.01)
    end
end

--------------------------------------------------
-- TELETRANSPORTE INTELIGENTE
--------------------------------------------------
function TeleportToNPC(npc)
    if not (npc and npc.Parent and Root and Root.Parent) then return false end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    Root.CFrame = hrp.CFrame + Vector3.new(0, Config.FarmDistance, 0)
    return true
end

--------------------------------------------------
-- SISTEMA PRINCIPAL DE FARM INTELIGENTE
--------------------------------------------------
function StartQuestFarm()
    Config.AutoFarm = true
    
    while Config.AutoFarm do
        if not (Plr.Character and Plr.Character.Humanoid.Health > 0) then
            task.wait(2)
            continue
        end
        
        -- Obtener quest recomendado para tu nivel
        local recommendedQuest = GetRecommendedQuest()
        
        if recommendedQuest then
            local enemyName = recommendedQuest.EnemyName
            local questName = recommendedQuest.QuestName
            local requiredLevel = recommendedQuest.Stage.LevelReq
            
            print("🎯 QUEST: " .. questName)
            print("🎯 OBJETIVO: " .. enemyName .. " | Nivel req: " .. requiredLevel)
            
            -- Buscar NPC del quest
            local npc = FindQuestNPC(enemyName)
            
            if npc then
                print("🎯 ENCONTRADO: " .. npc.Name .. " | Vida: " .. math.floor(npc.Humanoid.Health))
                
                -- Teletransportarse
                if TeleportToNPC(npc) then
                    -- Atacar con clics ultra rápidos
                    local attackCount = 0
                    while npc.Humanoid.Health > 0 and Config.AutoFarm do
                        UltraFastClicks()
                        attackCount = attackCount + 1
                        
                        -- Mostrar progreso
                        if attackCount % 5 == 0 then
                            print("🖱️ Ataque " .. attackCount .. " | Vida: " .. math.floor(npc.Humanoid.Health))
                        end
                        
                        task.wait(0.1)
                    end
                    
                    -- NPC eliminado
                    if npc.Humanoid.Health <= 0 then
                        print("💀 ELIMINADO: " .. npc.Name .. " | Ataques: " .. attackCount)
                        print("✅ Buscando próximo objetivo...")
                    end
                end
            else
                print("🔍 BUSCANDO: " .. enemyName)
            end
        else
            print("❌ No hay quest disponible para nivel: " .. GetPlayerLevel())
        end
        
        task.wait(0.5)
    end
end

