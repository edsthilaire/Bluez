-- FUNCIÓN PARA OBTENER NIVEL
function GetPlayerLevel()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats and stats:FindFirstChild("Level") then
        return stats.Level.Value
    end
    return 1
end

-- FUNCIÓN VOLAR SOBRE NPCs
function EnableFlight()
    if not AFSettings.FlyMode then return end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        -- Mantener altura fija sobre el NPC
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, AFSettings.FarmDistance, 0)
    end
end

-- FUNCIÓN BUSCAR NPC MÁS CERCANO
function FindNearestNPC()
    local closestNPC = nil
    local closestDistance = math.huge
    local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
    
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 and npc:FindFirstChild("HumanoidRootPart") then
            local distance = (playerPos - npc.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestNPC = npc
            end
        end
    end
    
    return closestNPC, closestDistance
end

-- FUNCIÓN ATAQUE MEJORADO
function AdvancedAttack(npc)
    if not npc then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Teletransportarse a posición de ataque
    local npcPos = npc.HumanoidRootPart.Position
    local attackPos = npcPos + Vector3.new(0, AFSettings.FarmDistance, 0)
    char.HumanoidRootPart.CFrame = CFrame.new(attackPos)
    
    -- Ejecutar combo de ataques
    local attacks = {"E", "F", "R", "T", "Y", "G", "H"}
    
    for i = 1, 3 do  -- Repetir combo 3 veces
        for _, key in pairs(attacks) do
            if not AFSettings.AutoFarm then break end
            
            VirtualInput:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInput:SendKeyEvent(false, key, false, game)
            task.wait(0.1)
        end
        task.wait(0.5)
    end
end

-- FUNCIÓN VERIFICAR ISLA ACTUAL
function GetCurrentIsland()
    local playerLevel = GetPlayerLevel()
    local recommendedIsland = IslandsByLevel[1]
    
    for _, island in pairs(IslandsByLevel) do
        if playerLevel >= island.Level then
            recommendedIsland = island
        else
            break
        end
    end
    
    return recommendedIsland
end

-- FUNCIÓN CAMBIAR DE ISLA AUTOMÁTICAMENTE
function AutoChangeIsland()
    if not AFSettings.AutoNewIsland then return end
    
    local currentIsland = GetCurrentIsland()
    LocalPlayer.Character.HumanoidRootPart.CFrame = currentIsland.Position
    print("🏝️ Teletransportado a: " .. currentIsland.Name)
    task.wait(3)
end

-- FUNCIÓN PRINCIPAL DE FARM
function StartAutoFarm()
    AFSettings.AutoFarm = true
    
    getgenv().FarmLoop = RunService.Heartbeat:Connect(function()
        if not AFSettings.AutoFarm then
            getgenv().FarmLoop:Disconnect()
            return
        end
        
        if LocalPlayer.Character and LocalPlayer.Character.Humanoid.Health > 0 then
            pcall(function()
                -- Buscar NPC más cercano
                local npc, distance = FindNearestNPC()
                
                if npc and distance < AFSettings.AttackRange then
                    -- Activar modo vuelo
                    if AFSettings.FlyMode then
                        EnableFlight()
                    end
                    
                    -- Atacar NPC
                    if AFSettings.AttackFromDistance then
                        AdvancedAttack(npc)
                    end
                    
                else
                    -- Si no hay NPCs, cambiar de isla
                    AutoChangeIsland()
                end
            end)
        end
    end)
end

