-- FUNCIONES BÁSICAS
function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

function GetPlayerLevel()
    local data = Player:FindFirstChild("Data")
    if data then
        local level = data:FindFirstChild("Level")
        if level then
            return level.Value
        end
    end
    return 1
end

function FindNearestNPC()
    if not IsAlive(Character) then return nil end
    
    local closestNPC = nil
    local closestDistance = math.huge
    
    local searchFolders = {"Enemies", "NPCs", "Monsters", "BasicMob"}
    
    for _, folderName in pairs(searchFolders) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, npc in pairs(folder:GetChildren()) do
                if npc:IsA("Model") and IsAlive(npc) then
                    local hrp = npc:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local distance = (Root.Position - hrp.Position).Magnitude
                        if distance < closestDistance and distance < 500 then
                            closestDistance = distance
                            closestNPC = npc
                        end
                    end
                end
            end
        end
    end
    
    -- Buscar bosses
    for _, npc in pairs(Workspace:GetChildren()) do
        if npc:IsA("Model") and IsAlive(npc) and npc:GetAttribute("IsBoss") then
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local distance = (Root.Position - hrp.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestNPC = npc
                end
            end
        end
    end
    
    return closestNPC
end

function TeleportTo(position)
    if not IsAlive(Character) then return false end
    if typeof(position) == "Instance" then
        position = position.Position
    end
    Root.CFrame = CFrame.new(position + Vector3.new(0, Settings.FarmDistance, 0))
    return true
end

function TeleportToNPC(npc)
    if not npc or not IsAlive(npc) then return false end
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return TeleportTo(hrp.Position)
end

-- SISTEMA DE ATAQUE
function PerformAttack()
    if not IsAlive(Character) then return end
    
    local attackKeys = {"E", "F", "R", "T", "Y", "G", "H"}
    local tool = Character:FindFirstChildOfClass("Tool")
    
    if tool then
        if Settings.AutoClick then
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.05)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
        
        for _, key in pairs(attackKeys) do
            VirtualInput:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInput:SendKeyEvent(false, key, false, game)
            task.wait(0.1)
        end
    end
end

-- HABILIDADES AUTOMÁTICAS
function AutoHaki()
    if not Settings.AutoBuso then return end
    VirtualInput:SendKeyEvent(true, "Q", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Q", false, game)
end

function AutoKen()
    if not Settings.AutoKen then return end
    VirtualInput:SendKeyEvent(true, "Z", false, game)
    task.wait(0.1)
    VirtualInput:SendKeyEvent(false, "Z", false, game)
end

-- MEJORAS DE PLAYER
function ApplyPlayerStats()
    if not IsAlive(Character) then return end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = Settings.WalkSpeed
        humanoid.JumpPower = Settings.JumpPower
    end
end

function ToggleNoclip()
    if Settings.Noclip then
        if NoclipConnection then NoclipConnection:Disconnect() end
        NoclipConnection = RunService.Stepped:Connect(function()
            if IsAlive(Character) then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

-- SISTEMA VISUAL
function ToggleFullBright()
    if Settings.FullBright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
    end
end

function OptimizeGraphics()
    if Settings.LowGFX then
        settings().Rendering.QualityLevel = 1
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Part") then
                obj.Material = Enum.Material.Plastic
            end
        end
    end
end

-- AUTO FARM SYSTEM
function StartAutoFarm()
    while Settings.AutoFarm and task.wait(0.3) do
        if not IsAlive(Character) then
            task.wait(2)
            Character = Player.Character or Player.CharacterAdded:Wait()
            Root = Character:WaitForChild("HumanoidRootPart")
            continue
        end
        
        ApplyPlayerStats()
        AutoHaki()
        AutoKen()
        
        local npc = FindNearestNPC()
        
        if npc then
            TargetNPC = npc
            if TeleportToNPC(npc) then
                PerformAttack()
                
                local humanoid = npc:FindFirstChildOfClass("Humanoid")
                local health = humanoid and math.floor(humanoid.Health) or "N/A"
                print("🎯 Farmeando: " .. npc.Name .. " | Vida: " .. health)
            end
        else
            print("🔍 Buscando NPCs...")
            TargetNPC = nil
        end
    end
end

